# ===========================================
# CHRONOS SYSTEM - ENVIRONMENT CONFIGURATION
# ===========================================

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
# PostgreSQL (Production/Vercel)
DATABASE_URL="postgresql://postgres:password@localhost:5432/chronos"
# SQLite (Local Development - Alternative)
# DATABASE_URL="file:./dev.db"

# ===========================================
# NEXTAUTH.JS CONFIGURATION
# ===========================================
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-key-change-in-production-minimum-32-characters"

# ===========================================
# GOOGLE OAUTH CONFIGURATION
# ===========================================
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-your-google-client-secret"

# ===========================================
# QR CODE SECURITY
# ===========================================
QR_SECRET="your-qr-secret-key-for-development-change-in-production"

# ===========================================
# EMAIL CONFIGURATION (NODEMAILER)
# ===========================================
# SMTP Configuration for production
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="noreply@chronos.com"

# Gmail App Password Instructions:
# 1. Enable 2-Factor Authentication
# 2. Go to Google Account Settings > Security > App passwords
# 3. Generate app password for "Mail"
# 4. Use the generated password in SMTP_PASS

# Alternative SMTP providers:
# Outlook: smtp-mail.outlook.com:587
# Yahoo: smtp.mail.yahoo.com:587
# SendGrid: smtp.sendgrid.net:587

# ===========================================
# OPTIONAL CONFIGURATIONS
# ===========================================
# Redis URL (for rate limiting and caching)
# Required in production, optional in development (uses in-memory fallback)
REDIS_URL="redis://localhost:6379"
# Enable/disable Redis caching (set to false to disable)
REDIS_ENABLED="true"
# For Vercel, use Vercel KV or Upstash Redis
# REDIS_URL="redis://default:password@your-redis-host:6379"

# Node Environment
NODE_ENV="development"

# ===========================================
# VERCEL DEPLOYMENT (DO NOT COMMIT)
# ===========================================
# These are automatically set by Vercel
# VERCEL_URL=""
# VERCEL_ENV=""

# ===========================================
# PRODUCTION ENVIRONMENT VARIABLES
# ===========================================
# Set these in Vercel Dashboard for production:
# - DATABASE_URL (PostgreSQL connection string)
# - NEXTAUTH_SECRET (strong secret key)
# - NEXTAUTH_URL (https://your-domain.vercel.app)
# - GOOGLE_CLIENT_ID (from Google Cloud Console)
# - GOOGLE_CLIENT_SECRET (from Google Cloud Console)
# - QR_SECRET (strong secret for QR code signing)

# ===========================================
# GITHUB SECRETS FOR CI/CD
# ===========================================
# Set these in GitHub Repository Settings > Secrets:
# - VERCEL_TOKEN (from Vercel account settings)
# - VERCEL_ORG_ID (from vercel link command)
# - VERCEL_PROJECT_ID (from vercel link command)
# - DATABASE_URL (PostgreSQL for production)
