# ===========================================
# CHRONOS SYSTEM - ENVIRONMENT CONFIGURATION
# ===========================================

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
# PostgreSQL (Production/Vercel)
DATABASE_URL="postgresql://postgres:password@localhost:5432/chronos"
# SQLite (Local Development - Alternative)
# DATABASE_URL="file:./dev.db"

# ===========================================
# NEXTAUTH.JS CONFIGURATION
# ===========================================
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-key-change-in-production-minimum-32-characters"

# ===========================================
# GOOGLE OAUTH CONFIGURATION
# ===========================================
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-your-google-client-secret"

# ===========================================
# QR CODE SECURITY
# ===========================================
QR_SECRET="your-qr-secret-key-for-development-change-in-production"

# ===========================================
# EMAIL (SMTP via Gmail / Google Workspace)
# ===========================================
# Para usar com Gmail ou Google Workspace (@ifce.edu.br):
#
# 1. Ative a verificação em 2 etapas na conta Google:
#    https://myaccount.google.com/security
#
# 2. Gere uma "Senha de app" (App Password):
#    https://myaccount.google.com/apppasswords
#    → Selecione "Outro (nome personalizado)" → "Chronos System"
#    → Copie a senha de 16 caracteres gerada (sem espaços)
#
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="cti.maracanau@ifce.edu.br"
SMTP_PASSWORD="xxxx xxxx xxxx xxxx"
SMTP_FROM="Chronos IFCE <cti.maracanau@ifce.edu.br>"

# ===========================================
# CRON JOB SECURITY
# ===========================================
# Segredo para autenticar chamadas dos endpoints /api/cron/* e /api/notifications/cron
# Gere um valor seguro: openssl rand -base64 32
CRON_SECRET="seu-segredo-aqui"

# Obs: O start-system.sh configura o crontab automaticamente com base nessas variáveis.
# No GitHub Actions, adicione CRON_SECRET em: Settings > Secrets > Actions.

# ===========================================
# WEB PUSH NOTIFICATIONS (VAPID) - Opcional
# ===========================================
# Gere as chaves com: npx web-push generate-vapid-keys
# VAPID_SUBJECT deve ser uma URL (ex: mailto:admin@exemplo.com ou https://seu-dominio.com)
#
# VAPID_PUBLIC_KEY="BEl62iUYgUivxIkv69yViEuiBIa-Ib9-SkvMeAtA3LFgDzkrxZJjSgSnfckjBJuBkr3qBUYIHBQFLXYp5Nksh8U"
# VAPID_PRIVATE_KEY="UUxI4O8-FbRouAevSmBQ6co62groMDIkd8a406EfkI0"
# VAPID_SUBJECT="mailto:cti.maracanau@ifce.edu.br"

# ===========================================
# OPTIONAL CONFIGURATIONS
# ===========================================
# Redis URL (for rate limiting and caching)
# Required in production, optional in development (uses in-memory fallback)
REDIS_URL="redis://localhost:6379"
# Enable/disable Redis caching (set to false to disable)
REDIS_ENABLED="true"
# For Vercel, use Vercel KV or Upstash Redis
# REDIS_URL="redis://default:password@your-redis-host:6379"

# Node Environment
NODE_ENV="development"

# ===========================================
# VERCEL DEPLOYMENT (DO NOT COMMIT)
# ===========================================
# These are automatically set by Vercel
# VERCEL_URL=""
# VERCEL_ENV=""

# ===========================================
# PRODUCTION ENVIRONMENT VARIABLES
# ===========================================
# Set these in Vercel Dashboard for production:
# - DATABASE_URL (PostgreSQL connection string)
# - NEXTAUTH_SECRET (strong secret key)
# - NEXTAUTH_URL (https://your-domain.vercel.app)
# - GOOGLE_CLIENT_ID (from Google Cloud Console)
# - GOOGLE_CLIENT_SECRET (from Google Cloud Console)
# - QR_SECRET (strong secret for QR code signing)

# ===========================================
# GITHUB SECRETS FOR CI/CD
# ===========================================
# Set these in GitHub Repository Settings > Secrets:
# - VERCEL_TOKEN (from Vercel account settings)
# - VERCEL_ORG_ID (from vercel link command)
# - VERCEL_PROJECT_ID (from vercel link command)
# - DATABASE_URL (PostgreSQL for production)
