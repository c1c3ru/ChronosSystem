
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}
generator client {
  provider = "prisma-client-js"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                      String                   @id @default(cuid())
  name                    String?
  email                   String                   @unique
  emailVerified           DateTime?
  image                   String?
  password                String?
  role                    String                   @default("EMPLOYEE")
  phone                   String?
  address                 String?
  birthDate               DateTime?
  emergencyContact        String?
  emergencyPhone          String?
  department              String?
  startDate               DateTime?
  siapeNumber             String?
  profileComplete         Boolean                  @default(false)
  twoFactorSecret         String?
  twoFactorEnabled        Boolean                  @default(false)
  contractType            String                   @default("ESTAGIO_20H")
  contractStartDate       DateTime?
  contractEndDate         DateTime?
  weeklyHours             Int                      @default(20)
  dailyHours              Int                      @default(4)
  hourBalance             Float                    @default(0)
  shift                   String                   @default("MORNING")
  shiftStartTime          String                   @default("08:00")
  shiftEndTime            String                   @default("12:00")
  workingDaysPerWeek      Int                      @default(5)
  allowFlexibleHours      Boolean                  @default(false)
  isActive                Boolean                  @default(true)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  accounts                Account[]
  attendanceRecords       AttendanceRecord[]
  auditLogs               AuditLog[]
  formDrafts              FormDraft[]
  hourBalances            HourBalance[]
  reviewedJustifications  Justification[]          @relation("JustificationReviewer")
  justifications          Justification[]
  monthlyBalances         MonthlyBalance[]
  passwordResetTokens     PasswordResetToken[]
  qrEvents                QrEvent[]
  sessions                Session[]
  attendanceNotifications AttendanceNotification[]
  pushSubscriptions       PushSubscription[]

  @@index([role])
  @@index([department])
  @@index([contractType])
  @@index([shift])
}

model AttendanceNotification {
  id             String    @id @default(cuid())
  userId         String
  type           String
  sentAt         DateTime  @default(now())
  acknowledgedAt DateTime?
  expiresAt      DateTime
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("attendance_notifications")
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  expires   DateTime
  used      Boolean   @default(false)
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

model Machine {
  id                String             @id @default(cuid())
  name              String
  location          String
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  latitude          Float?
  longitude         Float?
  attendanceRecords AttendanceRecord[]
  qrEvents          QrEvent[]
}

model AttendanceRecord {
  id            String   @id @default(cuid())
  userId        String
  machineId     String
  type          String
  timestamp     DateTime @default(now())
  latitude      Float?
  longitude     Float?
  qrData        String
  hash          String
  prevHash      String?
  justification String?
  machine       Machine  @relation(fields: [machineId], references: [id], onDelete: Cascade)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, timestamp(sort: Desc)])
  @@index([machineId, timestamp(sort: Desc)])
  @@index([userId, type, timestamp(sort: Desc)])
  @@index([timestamp(sort: Desc)])
  @@index([userId, timestamp(sort: Desc), type])
  @@index([hash])
}

model QrEvent {
  id        String    @id @default(cuid())
  machineId String
  qrData    String
  nonce     String    @unique
  expiresAt DateTime
  used      Boolean   @default(false)
  usedAt    DateTime?
  usedBy    String?
  createdAt DateTime  @default(now())
  machine   Machine   @relation(fields: [machineId], references: [id])
  user      User?     @relation(fields: [usedBy], references: [id])

  @@index([nonce])
  @@index([machineId, createdAt])
  @@index([used, expiresAt])
  @@index([expiresAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  resource  String
  details   String?
  timestamp DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId, timestamp])
  @@index([action, timestamp])
}

model Justification {
  id            String    @id @default(cuid())
  userId        String
  type          String
  category      String?
  date          DateTime
  reason        String
  status        String    @default("PENDING")
  adminResponse String?
  reviewedAt    DateTime?
  reviewedBy    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  reviewer      User?     @relation("JustificationReviewer", fields: [reviewedBy], references: [id])
  user          User      @relation(fields: [userId], references: [id])

  @@index([userId, date])
  @@index([status])
  @@index([status, date])
}

model HourBalance {
  id             String   @id @default(cuid())
  userId         String
  date           DateTime @default(now())
  workedHours    Float
  expectedHours  Float
  balance        Float
  weeklyBalance  Float
  monthlyBalance Float
  description    String?
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id])

  @@index([userId, date(sort: Desc)])
  @@index([date])
}

model MonthlyBalance {
  id            String   @id @default(cuid())
  userId        String
  month         Int
  year          Int
  totalWorked   Float
  totalExpected Float
  totalBalance  Float
  status        String   @default("OPEN")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month, year])
  @@index([userId, year])
}

model FormDraft {
  id        String   @id @default(cuid())
  userId    String
  formType  String
  formData  String // Alterar de Json para String
  status    String   @default("DRAFT")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, formType])
  @@index([userId, formType])
  @@index([status])
}


model Holiday {
  id          String   @id @default(cuid())
  date        DateTime @unique
  name        String
  description String?
  type        String   @default("NATIONAL")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
}

// Agendamento de visitas de escolas aos laboratórios
model Laboratory {
  id          String     @id @default(cuid())
  sigla       String     @unique
  nome        String
  descricao   String
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  visits      LabVisit[]

  @@index([isActive])
}

model LabVisit {
  id     String     @id @default(cuid())
  labId  String
  lab    Laboratory @relation(fields: [labId], references: [id], onDelete: Cascade)

  // Campos públicos (LGPD: únicos expostos por /api/lab-visits/public)
  responsibleName String
  schoolName      String
  studentCount    Int
  visitDate       DateTime
  shift           String // MORNING | AFTERNOON | NIGHT

  // Dados de contato — NUNCA retornados pelo endpoint público
  contactEmail String
  contactPhone String

  // Toda visita nasce PENDING. Só um usuário autenticado pode aprová-la
  // (ver POST /api/lab-visits/[id]/approve), o que dispara a criação do
  // evento no Google Calendar.
  status                String   @default("PENDING") // PENDING | CONFIRMED | CANCELLED
  googleCalendarEventId String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([labId, visitDate, shift])
  @@index([status])
}
