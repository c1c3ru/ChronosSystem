{
  "name": "chronos-system",
  "version": "2.0.0",
  "description": "Sistema de Registro de Ponto Eletrônico - Monolito Next.js",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev -p 5000 -H 0.0.0.0",
    "build": "next build",
    "postinstall": "prisma generate || true",
    "start": "next start -p 5000 -H 0.0.0.0",
    "lint": "eslint . --ext .ts,.tsx --config .eslintrc.json",
    "lint:fix": "eslint . --ext .ts,.tsx --config .eslintrc.json --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:qr": "playwright test qr-scanner",
    "test:e2e:qr-debug": "./scripts/test-qr-scanner.sh --debug",
    "test:e2e:qr-ui": "./scripts/test-qr-scanner.sh --ui",
    "test:e2e:qr-chrome": "./scripts/test-qr-scanner.sh --browser=chromium",
    "test:e2e:qr-firefox": "./scripts/test-qr-scanner.sh --browser=firefox",
    "test:e2e:qr-webkit": "./scripts/test-qr-scanner.sh --browser=webkit",
    "test:e2e:qr-advanced": "./scripts/test-qr-scanner.sh --advanced",
    "deploy": "./scripts/deploy.sh production",
    "deploy:preview": "./scripts/deploy.sh preview",
    "deploy:check": "./scripts/check-migration.sh",
    "vercel:pull": "vercel pull --yes --environment=production",
    "vercel:env": "vercel env ls",
    "test:e2e:report": "playwright show-report",
    "test:qr": "./scripts/test-qr-scanner.sh",
    "test:all": "npm run test && npm run test:e2e"
  },
  "dependencies": {
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^5.22.0",
    "@tailwindcss/forms": "^0.5.11",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "^10.5.0",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "date-fns": "^2.30.0",
    "framer-motion": "^10.16.5",
    "ioredis": "^5.8.2",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.294.0",
    "next": "^16.2.3",
    "next-auth": "^4.24.13",
    "next-intl": "^4.6.1",
    "nodemailer": "^9.0.1",
    "pdfmake": "^0.3.7",
    "postcss": "^8.5.15",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sonner": "^2.0.7",
    "speakeasy": "^2.0.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-react": "^5.31.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "web-push": "^3.6.7",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@swc/helpers": "^0.5.23",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^14.3.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/glob": "^8.1.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.9.0",
    "@types/nodemailer": "^8.0.0",
    "@types/pdfmake": "^0.3.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@types/speakeasy": "^2.0.10",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-react": "^5.18.0",
    "@typescript-eslint/eslint-plugin": "^8.58.1",
    "@typescript-eslint/parser": "^8.58.1",
    "baseline-browser-mapping": "^2.10.8",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.0.3",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.3.0",
    "minimatch": "8.0.7",
    "playwright": "^1.40.0",
    "prettier": "3.8.3",
    "prisma": "^5.22.0",
    "tsx": "^4.1.4",
    "typescript": "^5.2.2",
    "yaml": "^2.8.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "minimatch": "8.0.7",
    "glob": "9.3.5",
    "nodemailer": "^9.0.1"
  }
}
